# Postgres. When running via docker compose, host is the service name "db".
DATABASE_URL=postgres://postgres:devpass@localhost:5432/billing

# Stripe test mode keys. Get these free, no card required, from
# https://dashboard.stripe.com/test/apikeys (toggle "Test mode" on).
STRIPE_SECRET_KEY=sk_test_your_key_here

# From `stripe listen --forward-to localhost:8000/webhooks/stripe` output,
# or from your webhook endpoint's settings in test mode.
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# The Stripe Price ID for the "Pro" plan's monthly subscription (test mode).
# Create it under Product Catalog -> Add product -> test mode.
STRIPE_PRO_PRICE_ID=price_your_price_id_here

CHECKOUT_SUCCESS_URL=http://localhost:8000/billing/success
CHECKOUT_CANCEL_URL=http://localhost:8000/billing/cancel

PORT=8000
